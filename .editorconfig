root = true

[*]
charset = utf-8
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.{js,mjs,cjs,ts,mts,vue,css,json}]
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

# 设计文档为 CRLF,不要被工具统一成 LF(见 .claude/skills/smart-naive-table-dev)
[docs/smart-naive-table-design.{html,md}]
end_of_line = crlf

[docs/smart-naive-table-spec.md]
end_of_line = crlf
